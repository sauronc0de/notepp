{
  "name": "🐳[${localWorkspaceFolderBasename}]",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "WORKSPACE_DIR": "/workspaces/${localWorkspaceFolderBasename}",
      "PROJECT_NAME": "${localWorkspaceFolderBasename}"
    }
  },
  "containerEnv": {
    "PI_API_KEY": "${localEnv:PI_API_KEY}"
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.pi-projects/${localWorkspaceFolderBasename}",
      "target": "/home/devuser/.pi",
      "type": "bind"
    }
  ],
  "runArgs": [
    "--env=DISPLAY",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix",
    "--env=XAUTHORITY=/tmp/.docker.xauth"
  ],
  "postStartCommand": "sudo chown -R devuser /workspaces/${localWorkspaceFolderBasename} /home/devuser/.pi && chmod +x .devcontainer/docker_entrypoint.sh && .devcontainer/docker_entrypoint.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "mhutchie.git-graph",
        "ms-vscode.cmake-tools",
        "ms-azuretools.vscode-docker",
        "aaron-bond.better-comments",
        "seunlanlege.action-buttons",
        "ms-vscode.makefile-tools",
        "vadimcn.vscode-lldb",
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "jebbs.plantuml",
        "bierner.markdown-mermaid",
        "slevesque.shader"
      ]
    }
  }
}